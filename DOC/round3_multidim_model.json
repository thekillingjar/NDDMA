  "formula": {
    "source": "NDDMA arbitrary-dimensional multicore unified formula",
    "n_base": "B_core=B_total/block_dim; N_base=B_core*(block_dim/T_1+h_1)+H_1 for k<=2; B_core*(block_dim/T_2+h_2)+H_2 for k>2",
